# AssemblyAI Voice Agent API Configuration
# Get your API key from https://www.assemblyai.com/app/account
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Required to encrypt OAuth session cookies.
KARYA_SESSION_SECRET=replace_with_a_long_random_secret
KARYA_PUBLIC_URL=http://localhost:3000

# Google Calendar OAuth: redirect URI is ${KARYA_PUBLIC_URL}/api/integrations/google/callback
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# GitHub OAuth: callback URL is ${KARYA_PUBLIC_URL}/api/integrations/github/callback
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Brave Search API for current web research.
WEB_SEARCH_API_KEY=your_brave_search_api_key
